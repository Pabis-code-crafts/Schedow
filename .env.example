# Schedow Docker environment example.
# Copy .env.dev.example to .env.dev for local Docker development.
# Copy .env.prod.example to .env.prod on EC2 for production.
# Never commit real secrets.

VITE_API_BASE_URL=/
VITE_APP_NAME=Schedow
VITE_REGISTRATION_ENABLED=true
FRONTEND_PORT=3000
FRONTEND_HOST_BIND=0.0.0.0

FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_DOCKER_ORIGIN=http://localhost:3000
FRONTEND_PRODUCTION_ORIGIN=https://schedowai.duckdns.org

GATEWAY_PORT=8088
GATEWAY_HOST_BIND=0.0.0.0

USER_SERVICE_PORT=8082
SCHEDULE_SERVICE_PORT=8084
AI_SERVICE_PORT=8066

USER_SERVICE_URL=http://user-service:8082
SCHEDULE_SERVICE_URL=http://schedule-service:8084
AI_SERVICE_URL=http://ai-service:8066

JWT_SECRET=replace-with-a-strong-secret-at-least-32-chars
REGISTRATION_ENABLED=true

# Optional server-side demo supervisor provisioning. Prefer a BCrypt hash in production.
DEMO_SUPERVISOR_EMAIL=
DEMO_SUPERVISOR_PASSWORD_HASH=
DEMO_SUPERVISOR_PASSWORD=
DEMO_SUPERVISOR_NAME=Demo Supervisor
DEMO_SUPERVISOR_SITE=Hatfield

# Gateway rate limiting. Relaxed for local development.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW_SECONDS=60
AI_RATE_LIMIT_ENABLED=true
AI_RATE_LIMIT_REQUESTS=100
AI_RATE_LIMIT_WINDOW_SECONDS=60
GEMINI_API_KEY=replace-with-your-gemini-api-key
SCHEDULE_SERVICE_BASE_URL=http://schedule-service:8084/api/v1/schedules

POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-password

USER_DB_NAME=users_db
USER_DB_PORT=5432
USER_SERVICE_DB_URL=jdbc:postgresql://postgres-users:5432/users_db
USER_SERVICE_DB_USERNAME=postgres
USER_SERVICE_DB_PASSWORD=replace-with-a-strong-password
USER_SERVICE_DDL_AUTO=create
USER_SERVICE_SQL_INIT_MODE=always

SCHEDULE_DB_NAME=schedule_db
SCHEDULE_DB_PORT=5433
SCHEDULE_SERVICE_DB_URL=jdbc:postgresql://postgres-schedule:5432/schedule_db
SCHEDULE_SERVICE_DB_USERNAME=postgres
SCHEDULE_SERVICE_DB_PASSWORD=replace-with-a-strong-password

